[Unit]
Description=财报分析智能体（fr-agent · FastAPI）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/fr-agent/backend
Environment=FR_DATA_DIR=/home/ubuntu/fr-agent/data
Environment=PYTHONUNBUFFERED=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/ubuntu/fr-agent/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=3
MemoryMax=900M
CPUQuota=150%
TimeoutStopSec=15
KillMode=mixed
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
